{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0xfe10/cel-bridge/protocol/schema/environment.schema.json",
  "title": "cel-bridge environment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "variables"],
  "properties": {
    "schemaVersion": {"const": 1},
    "variables": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/typeSpec"}
    }
  },
  "$defs": {
    "typeSpec": {
      "oneOf": [
        {"$ref": "#/$defs/scalarType"},
        {"$ref": "#/$defs/listType"},
        {"$ref": "#/$defs/mapType"}
      ]
    },
    "scalarType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "null",
            "bool",
            "int",
            "uint",
            "double",
            "string",
            "bytes",
            "timestamp",
            "duration",
            "dyn"
          ]
        }
      }
    },
    "mapKeyType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["bool", "int", "uint", "string"]}
      }
    },
    "listType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "element"],
      "properties": {
        "type": {"const": "list"},
        "element": {"$ref": "#/$defs/typeSpec"}
      }
    },
    "mapType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "key", "value"],
      "properties": {
        "type": {"const": "map"},
        "key": {"$ref": "#/$defs/mapKeyType"},
        "value": {"$ref": "#/$defs/typeSpec"}
      }
    }
  }
}
