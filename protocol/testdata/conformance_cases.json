  {
    "name": "nested list value",
    "environment": {
      "schemaVersion": 1,
      "variables": {
        "groups": {
          "type": "list",
          "element": {"type": "list", "element": {"type": "string"}}
        }
      }
    },
    "source": "groups",
    "variables": {"groups": [["a", "b"], ["c"]]},
    "expected": {
      "kind": "list",
      "items": [
        {
          "kind": "list",
          "items": [
            {"kind": "string", "value": "a"},
            {"kind": "string", "value": "b"}
          ]
        },
        {"kind": "list", "items": [{"kind": "string", "value": "c"}]}
      ]
    }
  },
  {
    "name": "integer key map",
    "environment": {
      "schemaVersion": 1,
      "variables": {
        "scores": {
          "type": "map",
          "key": {"type": "int"},
          "value": {"type": "string"}
        }
      }
    },
    "source": "scores",
    "variables": {
      "scores": {
        "$cel_bridge": true,
        "kind": "map",
        "entries": [
          {
            "key": {"$cel_bridge": true, "kind": "int", "value": "2"},
            "value": {
              "$cel_bridge": true,
              "kind": "string",
              "value": "two"
            }
          },
          {
            "key": {"$cel_bridge": true, "kind": "int", "value": "1"},
            "value": {
              "$cel_bridge": true,
              "kind": "string",
              "value": "one"
            }
          }
        ]
      }
    },
    "expected": {
      "kind": "map",
      "entries": [
        {
          "key": {"kind": "int", "value": "1"},
          "value": {"kind": "string", "value": "one"}
        },
        {
          "key": {"kind": "int", "value": "2"},
          "value": {"kind": "string", "value": "two"}
        }
      ]
    }
  }
]
